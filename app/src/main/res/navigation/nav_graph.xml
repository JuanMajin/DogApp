<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/fragment_login">

    <fragment
        android:id="@+id/fragment_login"
        android:name="cl.tuapp.dogapp.view.fragment.Fragment_login"
        android:label="Fragment_login" />

    <action
        android:id="@+id/action_fragment_login_to_fragment_home"
        app:destination="@id/fragment_home"
        app:popUpTo="@id/fragment_login"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/fragment_home"
        android:name="cl.tuapp.dogapp.view.fragment.Fragment_home"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_fragment_home_to_fragment_nueva_cita"
            app:destination="@id/fragment_nueva_cita" />

        <action
            android:id="@+id/action_fragment_home_to_fragment_detalle_cita"
            app:destination="@id/fragment_detalle_cita" />
    </fragment>

    <fragment
        android:id="@+id/fragment_detalle_cita"
        android:name="cl.tuapp.dogapp.view.fragment.Fragment_detalle_cita"
        android:label="fragment_detalle_cita"
        tools:layout="@layout/fragment_detalle_cita">

        <action
            android:id="@+id/action_fragment_detalle_cita_to_fragment_editar_cita"
            app:destination="@id/fragment_editar_cita" />
    </fragment>

    <fragment
        android:id="@+id/fragment_nueva_cita"
        android:name="cl.tuapp.dogapp.view.fragment.Fragment_nueva_cita"
        android:label="Fragment_nueva_cita" />

    <fragment
        android:id="@+id/fragment_editar_cita"
        android:name="cl.tuapp.dogapp.view.fragment.Fragment_editar_cita"
        android:label="Editar cita"
        tools:layout="@layout/fragment_editar_cita">

        <argument
            android:name="idCita"
            app:argType="integer" />
    </fragment>

</navigation>