<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:context=".view.fragment.Fragment_detalle_cita">

        <!-- CRITERIO 1: Toolbar personalizada gris oscura curva -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_toolbar_curved"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_back_pink"
                android:padding="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="@string/regresar" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Nombre Mascota"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CRITERIO 3: Tarjeta de Detalles (Va de fondo, detrás de la imagen) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="80dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- Turno arriba a la derecha -->
                <TextView
                    android:id="@+id/tvTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="#1"
                    android:textColor="@color/pink_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <!-- Espacio reservado para que no se traslape texto con la imagen que sobresale -->
                <Space
                    android:id="@+id/spaceImage"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tvRaza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Husky Siberiano"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/spaceImage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tvSintoma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="No quiere comer"
                    android:textColor="@color/gray_hint"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp"
                    android:textAlignment="center"
                    app:layout_constraintTop_toBottomOf="@id/tvRaza"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Línea horizontal rosada -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/pink_primary"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tvSintoma"/>

                <TextView
                    android:id="@+id/tvPropietario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Propietario: Juan Pérez"
                    android:textColor="@color/dark_gray"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvTelefono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Teléfono: +56912345678"
                    android:textColor="@color/dark_gray"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tvPropietario"
                    app:layout_constraintStart_toStartOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- CRITERIO 2: Tarjeta de Imagen (Superpuesta con mayor elevation) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvImage"
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardCornerRadius="70dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toTopOf="@id/cvDetails"
            app:layout_constraintBottom_toTopOf="@id/cvDetails"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Al darle margin y dejar el fondo de la Card blanco, se genera el borde interno -->
            <ImageView
                android:id="@+id/ivMascota"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:contentDescription="@string/cd_imagen_mascota"
                tools:src="@drawable/ic_launcher_background" />
        </androidx.cardview.widget.CardView>

        <!-- CRITERIO 4: Botón Flotante Eliminar (Izquierda) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabEliminar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:src="@drawable/ic_delete"
            app:backgroundTint="@color/pink_primary"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="@string/eliminar_cita"/>

        <!-- CRITERIO 5: Botón Flotante Editar (Derecha) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:src="@drawable/ic_edit"
            app:backgroundTint="@color/dark_header"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="@string/editar_cita"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>