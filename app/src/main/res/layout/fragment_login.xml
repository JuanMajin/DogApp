<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
    HU 1.0 - Ventana Login (SCRUM-5)
    Criterio 1: fondo gris oscuro, sin toolbar (el tema de la app es NoActionBar).
    Criterio 2: cabeza de perro arriba a la derecha, PNG transparente, tamaño en % de pantalla.
    Criterio 3: título "DogApp" blanco, bold, fuente externa, centrado debajo de la imagen.
    Criterio 4: animación Lottie de huella abajo en el centro.
-->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_gray"
        tools:context=".view.fragment.LoginFragment">

        <!-- Criterio 2: imagen del perro. El ancho es el 45 % de la pantalla
                para que se adapte a distintos tamaños sin deformarse. -->
        <ImageView
            android:id="@+id/ivPerro"
            android:layout_width="wrap_content"
            android:layout_height="350dp"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="4dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/img_perro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.45" />

        <!-- Criterio 3: título DogApp centrado debajo de la imagen. -->

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/dogapp_font"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="60sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/ivPerro"
            app:layout_constraintHorizontal_bias="0.278"
            app:layout_constraintStart_toStartOf="@id/ivPerro"
            app:layout_constraintTop_toBottomOf="@id/ivPerro" />

        <!-- Criterio 4: huella dinámica (Lottie) abajo en el centro.
         Al tocarla se abre el BiometricPrompt (criterio 5, en la lógica). -->

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieHuella"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="64dp"
            android:clickable="true"
            android:contentDescription="@string/Cd_huella"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.4"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/fingerprint" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>